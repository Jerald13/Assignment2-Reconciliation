<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <AssemblyName>reconcile</AssemblyName>
    <RootNamespace>Reconciliation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reconciliation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ask the GC to compact the large object heap more eagerly. Each partition's dictionary/list
         backing arrays live on the LOH; without this, freed partitions linger and the peak working set
         doubles (measured 239 MB -> 106 MB on 2M rows, no change in run time). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>

</Project>
